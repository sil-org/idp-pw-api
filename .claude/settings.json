{
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "."
      ],
      "denyRead": [
        "./.env",
        "./local.env",
        "./application/common/config/local.php"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./local.env)",
      "Read(./application/common/config/local.php)"
    ]
  }
}
